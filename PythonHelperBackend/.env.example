# 复制为 .env 后填写真实值；不要把真实 .env 提交到 Git

# 运行环境
FLASK_ENV=development
FLASK_DEBUG=0
HOST=0.0.0.0
PORT=5000

# 用 python -c "import secrets; print(secrets.token_hex(32))" 生成
SECRET_KEY=

# SQLite 与上传目录
DATABASE_PATH=mistakes.db
PPT_UPLOAD_FOLDER=ppt_files
MAX_CONTENT_LENGTH=104857600

# 阿里云 DirectMail SMTP
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Python Helper

# AI 服务
AI_API_KEY=
AI_API_ENDPOINT=https://api.deepseek.com/v1/chat/completions
AI_ALLOWED_HOSTS=api.deepseek.com,api.openai.com

# Session Cookie（本地 HTTP 调试设为 false；生产 HTTPS 必须设为 true）
SESSION_COOKIE_SECURE=false

# CORS：可选，逗号分隔；留空时默认允许 localhost 和浏览器扩展来源
CORS_ALLOWED_ORIGINS=

# 可选：生产域名与 HTTPS 开关
SERVER_DOMAIN=localhost:5000
USE_HTTPS=false
